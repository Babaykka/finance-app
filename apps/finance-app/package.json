{
  "name": "finance-app",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "next typegen && tsc --noEmit",
    "prisma:generate": "prisma generate",
    "db:migrate": "node scripts/ensure-sqlite-db.mjs && prisma migrate dev",
